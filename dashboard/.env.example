# Copy this to .env.local and fill in real values.
# .env.local is git-ignored — never commit real credentials.

# PostgreSQL connection string (AWS RDS in prod, local DuckDB not supported here)
# In Vercel: set this in Project Settings → Environment Variables
DATABASE_URL=postgresql://ledger:ledger@localhost:5432/ledgerflow

# App name shown in the nav bar
NEXT_PUBLIC_APP_NAME=LedgerFlow
