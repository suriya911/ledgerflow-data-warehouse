# ── Local Development (PostgreSQL via Docker) ──────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=ledger
DB_PASSWORD=ledger
DB_NAME=ledgerflow

# ── Production (AWS RDS — set in Secrets Manager and Vercel) ───────────────
DATABASE_URL=postgresql://user:pass@your-rds-endpoint.rds.amazonaws.com:5432/ledgerflow

# ── AWS ────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=ledgerflow-raw-<your-account-id>
ECR_REPOSITORY=<your-account-id>.dkr.ecr.us-east-1.amazonaws.com/ledgerflow-airflow

# ── dbt ────────────────────────────────────────────────────────────────────
DBT_PROFILES_DIR=./dbt_ledgerflow
DBT_TARGET=dev

# ── Vercel / Next.js ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=LedgerFlow
